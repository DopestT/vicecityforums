{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vicecityforums.com/schemas/traffic-opportunity.schema.json",
  "title": "Vice City Forums Traffic Opportunity",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "detected_at",
    "topic",
    "source_urls",
    "confidence",
    "audience_intent",
    "target_vcf_destination",
    "recommended_asset",
    "conversion_goal",
    "claude_brief",
    "codex_task",
    "status",
    "approval_required"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "detected_at": {"type": "string", "format": "date-time"},
    "topic": {"type": "string", "minLength": 1},
    "source_urls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uri", "pattern": "^https://"}
    },
    "confidence": {"enum": ["high", "medium", "low"]},
    "audience_intent": {"type": "string", "minLength": 1},
    "target_vcf_destination": {"type": "string", "minLength": 1},
    "recommended_asset": {"enum": ["guide_update", "tracker", "comparison", "discussion", "clip_concept", "small_tool"]},
    "conversion_goal": {"type": "string", "minLength": 1},
    "claude_brief": {"type": "string", "minLength": 1},
    "codex_task": {"type": "string", "minLength": 1},
    "status": {"enum": ["detected", "verified", "briefed", "building", "review", "approved", "published", "measuring", "closed", "rejected"]},
    "approval_required": {"type": "boolean"},
    "utm_campaign": {"type": ["string", "null"]},
    "published_url": {"type": ["string", "null"]},
    "outcomes": {
      "type": "object",
      "properties": {
        "impressions": {"type": ["integer", "null"], "minimum": 0},
        "visits": {"type": ["integer", "null"], "minimum": 0},
        "completed_profiles": {"type": ["integer", "null"], "minimum": 0},
        "first_posts_or_replies": {"type": ["integer", "null"], "minimum": 0},
        "returning_members_7d": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
